# Образец файла с ключами сервисного аккаунта Yandex Cloud.
# Скопируйте его в yc-keys.env (в этой же папке) и подставьте свои значения.
# Как получить ключи — README, раздел «Сервисный аккаунт Yandex Cloud».

# Идентификатор статического ключа доступа (key_id)
YC_ACCESS_KEY_ID=
# Секретный ключ (secret; показывается только один раз — при создании ключа)
YC_SECRET_ACCESS_KEY=

# Необязательно: имя сервисного аккаунта — только для подписи в интерфейсе
YC_SERVICE_ACCOUNT=

# Необязательно: токен Vercel (можно ввести и в интерфейсе программы)
# VERCEL_TOKEN=
